Package cordelmaisum;

Helpers
 digito = ['0' .. '9'];
 letra_min = ['a' .. 'z'];
 letra_mai = ['A' .. 'Z'];
 letra = letra_min | letra_mai;
 espaco = ' ';
 under = '_';
 idchar = letra | digito | under;
 rc = 13;
 nl = 10;

Tokens
 a = 'A';
 funcao = 'funcao';
 arruma = 'arruma';
 se = 'Se';
