 div = '/';
 mod = '%';
 maior_igual_que = '>=';
 menor_igual_que = '<=';
 maior_que = '>';
 menor_que = '<';
 igual = '=';
 

 parentese_esquerdo = '(';
 parentese_direito = ')';
 colchete_esquerdo = '[';
 colchete_direito = ']';
 pipe = '|';

 id = letra_mai (idchar)*;

 vazio = (espaco | rc | nl)+;

Ignored Tokens
 vazio;
