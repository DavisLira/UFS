 ira = 'ira';
 te = 'te';
 retornar = 'retornar';

 com = 'Com';
 sua = 'sua';
 licenca = 'licenca';
 por = 'por';
 aqui = 'aqui';
 vamos = 'vamos';
 comecar = 'comecar';
 
 em = 'em';
 troca = 'troca';

 ja = 'Ja';
 ia = 'ia';
 esquecendo = 'esquecendo';
 preste = 'preste';
 atencao = 'atencao';
 favor = 'favor';
 
 diz = 'diz';
 ser = 'ser';
 que = 'que';
 tem = 'tem';
 como = 'como';

 se_mini = 'se';
 entao = 'entao';
